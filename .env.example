# CloakBrowser-Manager
CLOAK_BASE_URL=http://localhost:3000
CLOAK_API_KEY=

# Server
TZ=Asia/Shanghai

# Offline task store
OFFLINE_STORE_DRIVER=postgres
OFFLINE_STORE_DSN=postgres://drission:drission@localhost:5432/drission_cloud_driver?sslmode=disable
OFFLINE_SYNC_ENABLED=true
OFFLINE_SYNC_INTERVAL_SECONDS=15
OFFLINE_SYNC_CLEANUP_COMPLETED=true
OFFLINE_SYNC_CLEANUP_GRACE_SECONDS=30
